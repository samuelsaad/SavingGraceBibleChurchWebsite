---
import "../../admin/workbench.css";
const pageTitle = "Local administration — Saving Grace Bible Church";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
  </head>
  <body class="admin-workbench">
    <a class="skip-link" href="#admin-main">Skip to administration content</a>
    <div class="admin-shell">
      <aside class="sidebar" id="admin-sidebar" aria-label="Administration navigation">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">SG</span>
          <div>
            <strong>Saving Grace</strong>
            <span>Church administration</span>
          </div>
        </div>
        <p class="development-badge">Local development only</p>
        <nav aria-label="Workspace">
          <a href="/admin/cms" data-nav="cms">Website content</a>
          <a href="/admin" data-nav="dashboard">Review workspace</a>
          <a href="/admin/sermons" data-nav="sermons">All sermons</a>
          <a href="/admin/remaining-reviews" data-nav="remaining-reviews">Needs attention</a>
          <a href="/admin/ai-reviews?all=1" data-nav="ai-reviews">Original D-156 reviews</a>
          <span class="nav-label">Manage library</span>
          <a href="/admin/sermons/new" data-nav="new">New sermon</a>
          <span class="nav-label">Relationships</span>
          <a href="/admin/taxonomies/speakers" data-nav="speakers">Speakers</a>
          <a href="/admin/taxonomies/series" data-nav="series">Series</a>
          <a href="/admin/taxonomies/books" data-nav="books">Books</a>
          <span class="nav-label">Accountability</span>
          <a href="/admin/audit" data-nav="audit">Audit history</a>
        </nav>
        <div class="identity-card">
          <span aria-hidden="true">A</span>
          <div><strong>Development identity</strong><small>local-admin-0001 · not personal sign-in</small></div>
        </div>
      </aside>
      <button class="nav-backdrop" type="button" tabindex="-1" aria-label="Close navigation" hidden></button>
      <div class="workspace">
        <header class="topbar">
          <button class="menu-button" type="button" aria-expanded="false" aria-controls="admin-sidebar">
            <span class="sr-only">Toggle navigation</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
          <div>
            <p class="eyebrow">Sermon review workspace</p>
            <p class="connection-state"><span aria-hidden="true"></span> Private · local access only</p>
          </div>
        </header>
        <main id="admin-main" tabindex="-1" aria-busy="true">
          <div class="loading-card" role="status">Loading local administration…</div>
        </main>
      </div>
    </div>
    <div id="admin-announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <noscript><p class="noscript">This local administration dashboard requires JavaScript. Public website content will not.</p></noscript>
    <script>
      import "../../admin/dashboard";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #18251f;
    --muted: #55665e;
    --line: #dfe5e1;
    --paper: #f4f5f2;
    --panel: #ffffff;
    --forest: #1f503b;
    --forest-dark: #153d2d;
    --sage: #dfeae3;
    --gold: #ba8b37;
    --danger: #a73131;
    --danger-soft: #fff1f0;
    --focus: #165fd1;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--paper);
    overflow-x: hidden;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; overflow-x: hidden; background: var(--paper); }
  button, input, select, textarea { font: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  a { color: var(--forest); }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .skip-link { position: fixed; top: -5rem; left: 1rem; z-index: 100; background: white; padding: .75rem 1rem; border-radius: .5rem; }
  .skip-link:focus { top: 1rem; }
  .sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .admin-shell { min-height: 100vh; display: grid; grid-template-columns: 14.5rem minmax(0, 1fr); }
  .sidebar { position: sticky; top: 0; height: 100dvh; overflow-y: auto; display: flex; flex-direction: column; padding: 1.5rem .9rem; color: var(--ink); background: #fff; border-right: 1px solid var(--line); z-index: 20; }
  .brand { display: flex; gap: .8rem; align-items: center; padding: 0 .5rem 1.25rem; }
  .brand-mark { display: grid; place-items: center; flex-shrink: 0; width: 2.65rem; height: 2.65rem; border-radius: .65rem; background: var(--forest-dark); color: #fff4dc; font-family: var(--font-ui); font-weight: 700; }
  .brand strong, .brand div span { display: block; }
  .brand div span { margin-top: .15rem; color: var(--muted); font-size: .72rem; }
  .development-badge { margin: 0 .5rem 1.5rem; padding: .4rem .6rem; border: 1px solid var(--line); border-radius: .4rem; color: var(--muted); font-size: .69rem; letter-spacing: .04em; text-transform: uppercase; }
  .sidebar nav { display: grid; gap: .25rem; }
  .sidebar nav a { display: flex; align-items: center; min-height: 2.75rem; padding: .65rem .8rem; border-radius: .45rem; color: #40554a; text-decoration: none; font-size: .83rem; font-weight: 650; }
  .sidebar nav a:hover { background: var(--paper); color: var(--forest-dark); }
  .sidebar nav a[aria-current="page"] { background: #e8efe9; color: var(--forest-dark); box-shadow: inset 3px 0 var(--forest); }
  .nav-label { margin: 1rem .8rem .25rem; color: var(--muted); font-size: .65rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .identity-card { margin-top: auto; display: flex; gap: .7rem; align-items: center; padding: 1rem .4rem 0; border-top: 1px solid var(--line); }
  .identity-card > span { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--gold); color: #251c0d; font-weight: 800; }
  .identity-card strong, .identity-card small { display: block; }
  .identity-card strong { font-size: .82rem; }
  .identity-card small { margin-top: .3rem; color: var(--muted); font-size: .67rem; line-height: 1.5; }
  .workspace { min-width: 0; }
  .topbar { min-height: 4.4rem; display: flex; align-items: center; gap: 1rem; padding: .75rem clamp(1rem, 3vw, 2.5rem); border-bottom: 1px solid var(--line); background: white; }
  .eyebrow { margin: 0; color: var(--forest); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .connection-state { margin: .3rem 0 0; color: var(--muted); font-size: .8rem; }
  .connection-state span { display: inline-block; width: .55rem; height: .55rem; margin-right: .25rem; border-radius: 50%; background: #2f9b62; box-shadow: 0 0 0 .2rem #dff2e7; }
  .menu-button { display: none; border: 1px solid var(--line); border-radius: .55rem; background: white; padding: .55rem .7rem; }
  main { width: min(100%, 96rem); margin: 0 auto; padding: clamp(1.25rem, 2.5vw, 2rem); }
  .loading-card, .panel { border: 1px solid var(--line); border-radius: .75rem; background: var(--panel); }
  main > .panel + .panel, main > .panel + .stats-grid { margin-top: 1.25rem; }
  .loading-card { padding: 2rem; color: var(--muted); }
  .page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .page-heading h1 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.15rem); font-weight: 700; letter-spacing: -.035em; }
  .page-heading p { max-width: 52rem; margin: .45rem 0 0; color: var(--muted); line-height: 1.55; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 2.65rem; padding: .62rem .95rem; border: 1px solid var(--line); border-radius: .6rem; background: white; color: var(--ink); text-decoration: none; font-weight: 750; cursor: pointer; }
  .button:hover { border-color: #aabbb1; background: #fbfcfb; }
  .button.primary { border-color: var(--forest); background: var(--forest); color: white; }
  .button.primary:hover { background: var(--forest-dark); }
  .button.danger { border-color: #e8b8b4; background: var(--danger-soft); color: var(--danger); }
  .button.quiet { background: transparent; }
  .button:disabled { opacity: .55; cursor: not-allowed; }
  .source-video-link { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .35rem; padding: .55rem .7rem; border: 1px solid #a9c8b7; border-radius: .6rem; background: white; color: var(--forest-dark); font-weight: 800; line-height: 1.25; text-decoration-thickness: .08em; text-underline-offset: .18em; }
  .source-video-link:hover { border-color: var(--forest); background: #edf5f0; }
  .external-link-icon { font-size: 1.05em; font-weight: 900; }
  .no-source-link { display: inline-block; color: var(--muted); line-height: 1.4; }
  .stats-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .stats-grid.overview-stats { grid-template-columns: repeat(4, minmax(0,1fr)); }
  .stats-grid.compact { grid-template-columns: repeat(4, minmax(0,1fr)); margin: 1rem 0; }
  .stat-card { padding: 1.15rem; border: 1px solid var(--line); border-radius: .85rem; background: white; }
  .stat-card span { display: block; color: var(--muted); font-size: .78rem; font-weight: 700; text-transform: capitalize; }
  .stat-card strong { display: block; margin: .7rem 0 .4rem; font-size: 2rem; font-weight: 700; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
  .stat-card strong em { font-size: .95rem; font-style: normal; font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .stat-card small { color: var(--muted); font-size: .72rem; line-height: 1.5; }
  .stat-card.success { border-top: 3px solid #367052; }
  .stat-card.attention { border-top: 3px solid #bc9146; }
  .grid-two { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(17rem, .8fr); gap: 1.25rem; }
  .panel { min-width: 0; padding: 1.25rem; }
  .grid-two > * { min-width: 0; }
  .panel h2 { margin: 0 0 .8rem; font-size: 1.12rem; font-weight: 700; letter-spacing: -.015em; }
  .progress-panel { margin: 1.25rem 0; }
  .review-queue { display: grid; gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .review-queue li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem; border: 1px solid var(--line); border-radius: .75rem; background: #fbfcfb; }
  .review-queue strong, .review-queue span { display: block; }
  .review-queue span { margin-top: .25rem; color: var(--muted); font-size: .82rem; }
  progress { width: 100%; height: 1rem; accent-color: var(--forest); }
  dl { display: grid; grid-template-columns: auto 1fr; gap: .7rem 1rem; align-items: start; }
  dt, dd { margin: 0; }
  .callout { padding: 1rem; border-left: .3rem solid var(--gold); border-radius: .4rem; background: #fff8e9; color: #5f481c; line-height: 1.5; }
  .callout.danger { border-color: var(--danger); background: var(--danger-soft); color: #772323; }
  .provenance-grid code { overflow-wrap: anywhere; }
  .filters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; align-items: end; margin: 1rem 0; }
  .filters .wide { grid-column: 1 / -1; min-width: 0; }
  .filters .filters { grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); margin: .5rem 0 0; }
  .filter-primary { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)) auto; gap: .75rem; align-items: end; }
  .filter-more { margin: 1rem 0 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .filter-more summary { font-size: .85rem; font-weight: 700; color: var(--forest); cursor: pointer; }
  .filter-more summary span { margin-left: .6rem; color: var(--muted); font-weight: 400; font-size: .75rem; }
  label, legend { color: #35483e; font-size: .78rem; font-weight: 750; }
  label span { display: block; margin-bottom: .35rem; }
  input, select, textarea { width: 100%; min-height: 2.65rem; padding: .65rem .72rem; border: 1px solid #bdcac2; border-radius: .55rem; background: white; color: var(--ink); font-weight: 400; }
  textarea { min-height: 7rem; resize: vertical; line-height: 1.5; }
  select[multiple] { min-height: 9rem; }
  .field-hint { display: block; margin-top: .35rem; color: var(--muted); font-size: .73rem; font-weight: 400; line-height: 1.45; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .form-grid .wide { grid-column: 1 / -1; }
  .step-heading { margin-bottom: .4rem; }
  .step-heading > span { color: var(--forest); font-size: .72rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .step-heading h2 { margin: .25rem 0 .35rem; }
  .step-heading p { margin: 0; color: var(--muted); line-height: 1.5; }
  fieldset { margin: 0; padding: 1rem; border: 1px solid var(--line); border-radius: .75rem; }
  legend { padding: 0 .35rem; }
  .stack { display: grid; gap: 1rem; }
  .form-actions, .action-row { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; }
  .form-actions { position: sticky; bottom: 1rem; z-index: 5; margin-top: 1.2rem; padding: .8rem; border: 1px solid var(--line); border-radius: .75rem; background: rgba(255,255,255,.96); box-shadow: 0 .5rem 2rem rgba(0,0,0,.08); }
  .status-pill { display: inline-flex; align-items: center; padding: .27rem .55rem; border-radius: 99px; background: var(--sage); color: var(--forest-dark); font-size: .72rem; font-weight: 800; text-transform: capitalize; }
  .status-pill.published { background: #daf0e3; color: #14623b; }
  .status-pill.archived { background: #ececeb; color: #555; }
  .status-pill.scheduled { background: #e7e6fa; color: #4f4792; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: .75rem; }
  table { width: 100%; border-collapse: collapse; background: white; }
  th, td { padding: .78rem .8rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  th { color: var(--muted); background: #fafbfa; font-size: .72rem; letter-spacing: .05em; text-transform: uppercase; }
  tbody tr:last-child td { border-bottom: 0; }
  td a { font-weight: 760; text-decoration-thickness: .08em; text-underline-offset: .18em; }
  .subtle { color: var(--muted); font-size: .76rem; line-height: 1.45; }
  .pagination { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1rem; }
  .feedback { margin: 0 0 1rem; padding: .8rem 1rem; border-radius: .6rem; background: #edf5f0; color: var(--forest-dark); }
  .feedback.error { background: var(--danger-soft); color: #7b2424; }
  .seo-preview { padding: 1rem; border: 1px solid #cfdbd4; border-radius: .75rem; background: #f8fbf9; }
  .seo-preview strong, .seo-preview code { display: block; }
  .seo-preview code { margin-top: .35rem; color: var(--forest); overflow-wrap: anywhere; }
  dialog { width: min(34rem, calc(100% - 2rem)); padding: 0; border: 0; border-radius: 1rem; box-shadow: 0 1.5rem 5rem rgba(0,0,0,.3); }
  dialog::backdrop { background: rgba(10,25,18,.65); backdrop-filter: blur(3px); }
  .dialog-body { padding: 1.4rem; }
  .dialog-body h2 { margin-top: 0; font-family: var(--font-ui); }
  .radio-row { display: grid; grid-template-columns: auto 1fr; gap: .6rem; align-items: start; padding: .5rem 0; }
  .radio-row input { width: auto; min-height: auto; margin-top: .2rem; }
  .empty-state { padding: 2rem; text-align: center; color: var(--muted); }
  .checklist { display: grid; gap: .55rem; padding: 0; list-style: none; }
  .checklist li { display: flex; gap: .65rem; align-items: center; padding: .65rem .8rem; border-radius: .55rem; }
  .checklist .complete { background: #e7f4eb; color: #145a37; }
  .checklist .incomplete { background: #fff4df; color: #71511b; }
  .qa-editor { padding: 1rem; border: 1px solid var(--line); border-radius: .75rem; background: #fbfcfb; }
  .qa-editor-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .qa-editor-heading h3 { margin: 0; font-family: var(--font-ui); }
  .qa-editor > label { display: block; margin-top: .8rem; }
  .review-record-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 2rem; align-items: end; margin-bottom: 1.5rem; }
  .review-record-header h1 { max-width: 60rem; margin: .45rem 0 .25rem; font-family: var(--font-ui); font-size: clamp(1.8rem, 4vw, 2.65rem); font-weight: 500; letter-spacing: -.025em; }
  .review-record-header p { margin: .2rem 0 0; color: var(--muted); }
  .review-record-header .eyebrow { margin-top: .8rem; color: var(--forest); }
  .review-record-header progress { grid-column: 1 / -1; }
  .review-record-status { display: grid; gap: .5rem; justify-items: end; text-align: right; }
  .review-workflow-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; align-items: start; }
  .review-stage-nav { padding: .5rem; border: 1px solid var(--line); border-radius: .75rem; background: white; }
  .review-stage-nav ol { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .25rem; margin: 0; padding: 0; list-style: none; }
  .review-stage-button { display: grid; grid-template-columns: 1.6rem minmax(0,1fr); gap: .5rem; align-items: start; width: 100%; min-height: 4.5rem; padding: .65rem .5rem; border: 1px solid transparent; border-radius: .45rem; color: var(--ink); background: transparent; text-align: left; cursor: pointer; font-size: .75rem; }
  .review-stage-button:hover { background: var(--paper); }
  .review-stage-button.current { border-color: #a9c8b7; background: #edf5f0; }
  .review-stage-button strong, .review-stage-button small { display: block; }
  .review-stage-button strong { line-height: 1.25; }
  .review-stage-button small { margin-top: .2rem; color: var(--muted); font-size: .7rem; }
  .review-stage-number { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--sage); color: var(--forest-dark); font-weight: 850; }
  .review-stage-mark { display: none; }
  .review-stage-workspace { min-width: 0; }
  .review-stage-panel { min-width: 0; padding: clamp(1.2rem, 2.5vw, 2rem); border: 1px solid var(--line); border-radius: .75rem; background: white; }
  .review-stage-heading { max-width: 58rem; margin-bottom: 1.4rem; }
  .review-stage-heading > p:first-child { margin: 0 0 .35rem; color: var(--forest); font-size: .72rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .review-stage-heading h2 { margin: 0; font-family: var(--font-ui); font-size: clamp(1.55rem, 3vw, 2.1rem); font-weight: 500; }
  .review-stage-heading h2 + p { margin: .5rem 0 0; color: var(--muted); line-height: 1.55; }
  .review-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }
  .review-readonly-field { padding: .8rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--paper); }
  .review-readonly-field span, .review-readonly-field strong, .review-readonly-field small { display: block; }
  .review-readonly-field span { color: #35483e; font-size: .78rem; font-weight: 750; }
  .review-readonly-field strong { margin-top: .4rem; }
  .review-readonly-field small { margin-top: .3rem; color: var(--muted); }
  .source-summary { display: grid; gap: 1rem; margin-top: 1.25rem; padding: 1.2rem; border: 1px solid #c9d9d0; border-radius: .8rem; background: #f8fbf9; }
  .source-summary h3 { margin: .2rem 0 0; font-family: var(--font-ui); font-weight: 500; }
  .source-facts { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .75rem; }
  .source-facts div { min-width: 0; padding: .75rem; border-radius: .6rem; background: white; }
  .source-facts dt { color: var(--muted); font-size: .72rem; font-weight: 800; text-transform: uppercase; }
  .source-facts dd { margin-top: .3rem; overflow-wrap: anywhere; }
  .technical-provenance { border-top: 1px solid var(--line); padding-top: .8rem; }
  .technical-provenance summary { color: var(--forest); font-weight: 750; cursor: pointer; }
  .technical-provenance .provenance-grid { margin-top: 1rem; }
  .review-content-status { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--paper); }
  .review-content-status span { color: var(--muted); }
  .review-editor-label { display: block; }
  #review-transcript-body { width: 100%; min-height: 65vh; padding: 1rem; font-family: var(--font-ui); font-size: 1.05rem; line-height: 1.75; }
  #review-description-body { min-height: 16rem; padding: 1rem; font-size: 1rem; line-height: 1.65; }
  .review-counts { margin: -.45rem 0 0; color: var(--muted); font-variant-numeric: tabular-nums; }
  .review-stage-actions, .review-decision-bar, .review-item-pager, .qa-order-actions { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; }
  .review-stage-actions { justify-content: space-between; margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .review-decision-bar { position: sticky; bottom: 1rem; z-index: 4; padding: .8rem; border: 1px solid var(--line); border-radius: .75rem; background: rgba(255,255,255,.97); box-shadow: 0 .5rem 2rem rgba(0,0,0,.08); }
  .review-item-toolbar { display: grid; grid-template-columns: minmax(12rem, 20rem) 1fr; gap: .8rem; align-items: end; margin-bottom: 1rem; }
  .review-item-toolbar p { margin: 0 0 .7rem; white-space: nowrap; }
  .review-item-card { min-width: 0; padding: clamp(1rem, 2vw, 1.5rem); border: 1px solid #bfd1c7; border-radius: .85rem; background: #fbfdfc; }
  .review-item-card > header { display: flex; justify-content: space-between; gap: 1rem; align-items: start; }
