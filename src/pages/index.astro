---
// The static public home page renders through the same shell and components
// as the server-rendered site. The static build has no published sermon data,
// so it shows the honest "being prepared" state until a production runtime is
// selected.
import { renderFrontendHomePage } from "../frontend";

const html = renderFrontendHomePage({ sermons: [], series: [] });
---

<Fragment set:html={html} />
