---
// The static public home page renders through the same shell and components
// as the server-rendered site. The static build has no published sermon data,
// so it shows the honest "being prepared" state until a production runtime is
// selected.
import { emptyFilterOptions, renderFrontendHomePage } from "../frontend";
import { melbourneToday } from "../frontend/content/events";

const html = renderFrontendHomePage({ sermons: [], options: emptyFilterOptions, totalItems: 0, today: melbourneToday() });
---

<Fragment set:html={html} />
