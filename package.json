{
  "name": "saving-grace-bible-church-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:model-local": "tsx scripts/local-model-acceptance.ts",
    "test:postgres": "tsx tests/postgres-test-runner.ts",
    "test:watch": "vitest",
    "youtube:pilot-auth-local": "tsx src/youtube/pilot-caption-cli.ts auth",
    "youtube:pilot-inspect-local": "tsx src/youtube/pilot-caption-cli.ts inspect",
    "youtube:pilot-retrieve-local": "tsx src/youtube/pilot-caption-cli.ts retrieve",
    "youtube:wave1-map-local": "tsx src/youtube/wave1-caption-cli.ts map",
    "youtube:wave1-inspect-local": "tsx src/youtube/wave1-caption-cli.ts inspect",
    "youtube:wave1-retrieve-local": "tsx src/youtube/wave1-caption-cli.ts retrieve",
    "youtube:wave1-pilot-provenance-local": "tsx src/youtube/wave1-pilot-provenance-cli.ts",
    "enrichment:wave1-metadata-local": "tsx src/enrichment/wave1-process-cli.ts metadata",
    "enrichment:wave1-process-local": "tsx src/enrichment/wave1-process-cli.ts process",
    "enrichment:wave1-verify-local": "tsx src/enrichment/wave1-process-cli.ts verify",
    "migration:dry-run": "tsx src/migration/cli.ts --dry-run",
    "migration:load-local": "tsx src/migration/load-cli.ts",
    "db:apply-local": "tsx src/migration/schema-cli.ts --apply",
    "db:rollback-local": "tsx src/migration/schema-cli.ts --rollback",
    "db:apply-phase3b-local": "tsx src/migration/schema-cli.ts --apply --phase3b-only",
    "db:rollback-phase3b-local": "tsx src/migration/schema-cli.ts --rollback --phase3b-only",
    "db:apply-phase3b1-local": "tsx src/migration/schema-cli.ts --apply --phase3b1-only",
    "db:rollback-phase3b1-local": "tsx src/migration/schema-cli.ts --rollback --phase3b1-only",
    "db:apply-phase3b1a-local": "tsx src/migration/schema-cli.ts --apply --phase3b1a-only",
    "db:rollback-phase3b1a-local": "tsx src/migration/schema-cli.ts --rollback --phase3b1a-only",
    "db:apply-phase3b2-local": "tsx src/migration/schema-cli.ts --apply --phase3b2-only",
    "db:rollback-phase3b2-local": "tsx src/migration/schema-cli.ts --rollback --phase3b2-only",
    "db:apply-atomic-review-local": "tsx src/migration/schema-cli.ts --apply --atomic-review-only",
    "db:rollback-atomic-review-local": "tsx src/migration/schema-cli.ts --rollback --atomic-review-only",
    "reference:apply-local": "tsx src/migration/reference-catalogue-cli.ts --apply",
    "reference:rollback-local": "tsx src/migration/reference-catalogue-cli.ts --rollback",
    "enrichment:export-queue-local": "tsx src/enrichment/cli.ts --export-queue",
    "enrichment:import-draft-local": "tsx src/enrichment/cli.ts --import-bundle",
    "enrichment:pilot-local": "tsx src/enrichment/pilot-cli.ts",
    "enrichment:restore-remaining-pilot-local": "tsx src/enrichment/pilot-restore-cli.ts",
    "enrichment:punctuation-local": "tsx src/enrichment/pilot-punctuation-cli.ts",
    "launch-readiness:local": "tsx src/readiness/cli.ts",
    "api:local": "tsx src/server/local-api.ts",
    "dashboard:local": "cross-env API_HOST=127.0.0.1 ENABLE_LOCAL_TEST_IDENTITIES=1 ENABLE_LOCAL_DASHBOARD=1 tsx src/server/local-api.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "astro": "7.1.6",
    "googleapis": "175.0.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "cross-env": "10.1.0",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
