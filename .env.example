# Local development only. Never place real production or legacy credentials here.
DATABASE_URL=postgresql://local_user@127.0.0.1:5432/savinggrace_sermons_test
# The integration gate permits only this disposable loopback database.
TEST_DATABASE_URL=postgresql://local_user@127.0.0.1:5432/savinggrace_sermons_test
# Explicit opt-ins are required by fixture/test write commands.
ALLOW_LOCAL_DB_WRITE=0
RUN_POSTGRES_INTEGRATION=0
# Loopback harness only; never enable as a production authenticator.
ENABLE_LOCAL_TEST_IDENTITIES=0
ENABLE_LOCAL_DASHBOARD=0
API_HOST=127.0.0.1
API_PORT=4322
PUBLIC_SITE_URL=http://localhost:4321
LOG_LEVEL=info
